# MongoDB (replica set required for transactions; docker-compose.yml provides one)
MONGODB_URI=mongodb://localhost:27017/learn?replicaSet=rs0&directConnection=true

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (the only sign-in provider in production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated admin emails
ADMIN_EMAILS=you@example.com

# Dev-only email login (never enable in production). Added in the auth task.
AUTH_DEV_LOGIN=false

# CLI (scripts/content.ts) — API base URL and a token created in the admin UI
LEARN_API_URL=http://localhost:3000
LEARN_API_TOKEN=

# AI quiz coach via OpenRouter (https://openrouter.ai/keys). Optional: the key can also be saved in
# Admin → AI coach (encrypted with AUTH_SECRET), which overrides this one.
OPENROUTER_API_KEY=
# Defaults until an admin picks models in Admin → AI coach (primary + backup, free models listed first).
# Any OpenRouter model id; defaults to openai/gpt-4o-mini
OPENROUTER_MODEL=
# AI calls per user per UTC day (0 = no limit); defaults to 100
OPENROUTER_DAILY_LIMIT=

# Speaking practice audio storage (Cloudflare R2, S3 API token). Blank turns recording off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Cloudflare Workers AI token (speech-to-text); uses R2_ACCOUNT_ID
CF_AI_TOKEN=
# Transcriptions per user per UTC day (0 = no limit); defaults to 200
STT_DAILY_LIMIT=
